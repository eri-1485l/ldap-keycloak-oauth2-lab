[DEFAULT]
bantime = 600
findtime = 60
maxretry = 10
bantime.increment = true
bantime.factor = 2
bantime.maxtime = 1d
ignoreip = 127.0.0.1/8 172.29.0.20 172.29.0.1

[sshd]
enabled = false

[sshd-ddos]
enabled = false

[keycloak-auth]
enabled = true
port = 8080
filter = keycloak-auth
logpath = /var/log/keycloak/keycloak.log
maxretry = 10
findtime = 60
bantime = 600
action = iptables-allports[name=keycloak-auth]
